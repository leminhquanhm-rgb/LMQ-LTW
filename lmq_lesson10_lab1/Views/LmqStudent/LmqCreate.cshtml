@model lmq_lesson10_lab1.Models.LmqStudent
@using lmq_lesson10_lab1.Models

@{
    ViewData["Title"] = "Thêm sinh viên";
    Layout = "~/Views/Shared/_LmqMyLayout.cshtml";
}

<!-- Content Header -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">THÊM SINH VIÊN</h1>
            </div>
        </div>
    </div>
</div>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-user-plus mr-1"></i> Form thông tin sinh viên</h3>
            </div>
            
            <!-- Sử dụng thẻ form chuẩn MVC -->
            <form asp-controller="Student" asp-action="Add" method="post">
                <div class="card-body">
                    
                    <div class="form-group">
                        <label asp-for="Name">Họ tên</label>
                        <input asp-for="Name" class="form-control" placeholder="Nhập họ tên sinh viên" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email">Email</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="Nhập email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password">Mật khẩu</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Branch">Ngành học</label>
                        <!-- Dùng form-control thay vì form-select để tương thích tốt với Bootstrap 4 -->
                        <select asp-for="Branch"
                                asp-items="Html.GetEnumSelectList<LmqBranch>()"
                                class="form-control">
                            <option value="">-- Chọn ngành --</option>
                        </select>
                        <span asp-validation-for="Branch" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>Giới tính</label><br />
                        <div class="d-flex">
                            @foreach (LmqGender gender in ViewBag.AllGenders)
                            {
                                <div class="custom-control custom-radio mr-4">
                                    <input type="radio"
                                           id="gender_@gender"
                                           name="Gender"
                                           value="@gender"
                                           class="custom-control-input"
                                           @(Model != null && Model.Gender == gender ? "checked" : "") />
                                    <label class="custom-control-label" for="gender_@gender">
                                        @(gender == LmqGender.Male ? "Nam" : "Nữ")
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="DateOfBorth">Ngày sinh</label>
                        <input asp-for="DateOfBorth"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="DateOfBorth" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <div class="custom-control custom-checkbox">
                            <input asp-for="IsRegular" type="checkbox" class="custom-control-input" id="customCheckbox1" />
                            <label class="custom-control-label" for="customCheckbox1">Chính quy</label>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Address">Địa chỉ</label>
                        <textarea asp-for="Address" class="form-control" rows="3" placeholder="Nhập địa chỉ"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                </div>

                <!-- Footer của card chứa nút bấm -->
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save mr-1"></i> Thêm
                    </button>
                    <a asp-action="LmqIndex" class="btn btn-secondary ml-2">
                        <i class="fas fa-arrow-left mr-1"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}