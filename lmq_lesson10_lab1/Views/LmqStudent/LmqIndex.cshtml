@model IEnumerable<lmq_lesson10_lab1.Models.LmqStudent>
@using lmq_lesson10_lab1.Models

@{
    ViewData["Title"] = "Quản lý sinh viên";
    Layout = "~/Views/Shared/_LmqMyLayout.cshtml";
}

<!-- Content Header -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">QUẢN LÝ SINH VIÊN</h1>
            </div>
            <div class="col-sm-6 text-right">
                <!-- Thêm class btn btn-primary để nút bấm đẹp hơn -->
                <a asp-controller="LmqStudent" asp-action="LmqCreate" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Create Student
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-users mr-1"></i> Danh sách sinh viên</h3>
            </div>
            <div class="card-body p-0">
                <!-- Thêm table-hover và text-nowrap để bảng gọn gàng, chuyên nghiệp -->
                <table class="table table-striped table-hover text-nowrap">
                    <thead>
                        <tr>
                            <th>Mã</th>
                            <th>Họ tên</th>
                            <th>Ngày sinh</th>
                            <th>Ngành</th>
                            <th>Giới tính</th>
                            <th>Hệ đào tạo</th>
                            <th>Địa chỉ</th>
                            <th>Email</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>@s.Id</td>
                                <td>@s.Name</td>
                                <td>@s.DateOfBorth.ToShortDateString()</td>
                                <td>
                                    @(s.Branch switch
                                    {
                                        LmqBranch.IT => "CNTT",
                                        LmqBranch.BE => "Kinh tế",
                                        LmqBranch.CE => "Công trình",
                                        LmqBranch.EE => "Điện - Điện tử",
                                        _ => ""
                                    })
                                </td>
                                <td>
                                    @(s.Gender == LmqGender.Male ? "Nam" : "Nữ")
                                </td>
                                <td>
                                    <!-- Làm nổi bật hệ đào tạo bằng badge -->
                                    <span class="badge @(s.IsRegular ? "badge-success" : "badge-warning")">
                                        @(s.IsRegular ? "Chính quy" : "Phi chính quy")
                                    </span>
                                </td>
                                <td>@s.Address</td>
                                <td>@s.Email</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>