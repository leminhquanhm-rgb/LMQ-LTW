@model IEnumerable<Lmq_BTTL_Lab3.Models.Product>
<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-xs-4 col-sm-4 col-md-4 col-lg-4" style="margin-bottom:15px;">
            <div class="thumbnail">
                <img src="@item.Image" alt="@item.Name" />
                <div class="caption">
                    <p>@item.Name</p>
                </div>
            </div>
        </div>
    }
</div>