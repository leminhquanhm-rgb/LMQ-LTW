<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lmq_lesson05</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Lmq_lesson05.styles.css" asp-append-version="true" />
</head>
<body>
    <partial name="_LmqHeaderPartialView" />
    <partial name="_LmqBannerPartialView" />

    <div class="container">
        <main role="main" class="pb-3 row">
            <div class="col-md-3">
                @await Component.InvokeAsync("LmqCategory")
            </div>
            <div class="col-md-9">
                @RenderBody()
            </div>
            @RenderBody()
        </main>
    </div>

    <partial name="_LmqFooterPartialView"/>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
