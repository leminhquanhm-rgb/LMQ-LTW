@model IEnumerable<Lmq_lab3.Models.Book>
@{
    ViewData["Title"] = "Index";
}

<h2>Danh sách các cuốn sách</h2>

<form action="" method="POST" role="form" style="display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-bottom:15px;">
    <select name="AuthorId" class="form-control" asp-items="@ViewBag.authors" style="width:auto;">
        <option value="">Chọn tác giả</option>
    </select>
    <select name="GenreId" class="form-control" asp-items="@ViewBag.genres" style="width:auto;">
        <option value="">Chọn Thể loại</option>
    </select>
    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    <a asp-action="Create" class="btn btn-danger">Thêm mới</a>
</form>
<hr />

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Tiêu đề</th>
            <th>Tác giả</th>
            <th>Thể loại</th>
            <th>Giá</th>
            <th>Hình ảnh</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Id</td>
                <td>@book.Title</td>
                <td>@book.AuthorId</td>
                <td>@book.GenreId</td>
                <td>@book.Price</td>
                <td><img src="@book.Image" alt="@book.Title" width="40" /></td>
                <td><a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-primary">Sửa</a></td>
            </tr>
        }
    </tbody>
</table>

@{
    ViewData["Title"] = "Home Page";
}

<!-- Bài 2: PartialView Banner -->
<partial name="Banner" />
<hr />

<!-- Bài 3: nút bấm gọi jQuery Ajax -->
<button id="loadAjax" class="btn btn-sm btn-primary">Click load book từ partialResult</button>
<hr />
<div id="data-from-ajax" class="row">Loading data....</div>
<hr />

<!-- Bài 4: gọi trực tiếp ViewComponent Book -->
<h2>Popular Book Load từ BookComponent</h2>
@await Component.InvokeAsync("Book")

@section Scripts {
    <script>
        $('#loadAjax').click(function() {
            $('#data-from-ajax').load('/Book/PopularBook');
        })
    </script>
}