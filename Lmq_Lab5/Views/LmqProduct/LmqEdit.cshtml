@using Microsoft.AspNetCore.Mvc.Rendering
@model Lmq_Lab5.Models.LmqProduct

@{
    ViewData["Title"] = "LmqEdit";
}

<h1>Sửa sản phẩm</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="LmqEdit"
              method="post"
              enctype="multipart/form-data">

            <input type="hidden"
                   asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <!-- Tên sản phẩm -->
            <div class="form-group mb-3">
                <label asp-for="Name"
                       class="control-label">
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>
            </div>

            <!-- Ảnh hiện tại -->
            <div class="form-group mb-3">

                <label class="control-label">
                    Hình ảnh hiện tại
                </label>

                <br />

                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <img src="@Model.Image"
                         width="150"
                         height="150"
                         style="object-fit: cover;" />
                }

            </div>

            <!-- Chọn ảnh mới -->
            <div class="form-group mb-3">

                <label class="control-label">
                    Chọn ảnh mới
                </label>

                <input type="file"
                       name="ImageFile"
                       class="form-control"
                       accept="image/*" />

            </div>

            <!-- Giá chuẩn -->
            <div class="form-group mb-3">

                <label asp-for="Price"
                       class="control-label">
                </label>

                <input asp-for="Price"
                       class="form-control" />

                <span asp-validation-for="Price"
                      class="text-danger">
                </span>

            </div>

            <!-- Giá bán -->
            <div class="form-group mb-3">

                <label asp-for="SalePrice"
                       class="control-label">
                </label>

                <input asp-for="SalePrice"
                       class="form-control" />

                <span asp-validation-for="SalePrice"
                      class="text-danger">
                </span>

            </div>

            <!-- Mô tả -->
            <div class="form-group mb-3">

                <label asp-for="Description"
                       class="control-label">
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="5"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>

            </div>

            <!-- Danh mục -->
            <div class="form-group mb-3">

                <label asp-for="CategoryId"
                       class="control-label">
                </label>

                <select asp-for="CategoryId"
                        class="form-control"
                        asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">

                    <option value="">
                        -- Chọn danh mục --
                    </option>

                </select>

                <span asp-validation-for="CategoryId"
                      class="text-danger">
                </span>

            </div>

            <!-- Nút lưu -->
            <div class="form-group mt-3">

                <input type="submit"
                       value="Lưu thay đổi"
                       class="btn btn-primary" />

                <a asp-action="LmqIndex"
                   class="btn btn-secondary">
                    Quay lại
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}