@model IEnumerable<LmqLesson11Lab4.Models.LmqLearner>

@{
    ViewData["Title"] = "Danh sách sinh viên";
    Layout = "_Layout";
}

<div class="container mt-4">
    <h2 class="mb-4">Learner List</h2>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Mã</th>
                <th>Tên</th>
                <th>Họ</th>
                <th>Ngành</th>
                <th>Ngày nhập học</th>
                <th>Chức năng</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.LearnerID</td>
                    <td>@s.FirstMidName</td>
                    <td>@s.LastName</td>
                    <td>@s.Major?.MajorName</td>
                    <td>@s.EnrollmentDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@s.LearnerID"
                           class="btn btn-warning btn-sm">Sửa</a>

                        <a asp-action="Delete"
                           asp-route-id="@s.LearnerID"
                           class="btn btn-danger btn-sm">Xóa</a>

                        <a asp-action="Details"
                           asp-route-id="@s.LearnerID"
                           class="btn btn-info btn-sm">Chi tiết</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-action="Create" class="btn btn-primary">
        Create New Student
    </a>
</div>