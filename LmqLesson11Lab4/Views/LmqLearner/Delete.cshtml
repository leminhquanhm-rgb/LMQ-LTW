@model LmqLesson11Lab4.Models.LmqLearner

@{
    ViewData["Title"] = "Delete";
    Layout = "_Layout";
}

<div class="container mt-4">
    <h2 class="text-danger">Delete Learner</h2>

    <h5 class="mt-3">Are you sure you want to delete this?</h5>

    <hr />

    <dl class="row">
        <dt class="col-sm-3">
            Tên
        </dt>
        <dd class="col-sm-9">
            @Model.FirstMidName
        </dd>

        <dt class="col-sm-3">
            Họ
        </dt>
        <dd class="col-sm-9">
            @Model.LastName
        </dd>

        <dt class="col-sm-3">
            Chuyên ngành
        </dt>
        <dd class="col-sm-9">
            @Model.Major?.MajorName
        </dd>

        <dt class="col-sm-3">
            Ngày nhập học
        </dt>
        <dd class="col-sm-9">
            @Model.EnrollmentDate.ToString("dd/MM/yyyy")
        </dd>
    </dl>

    <form asp-action="Delete"
          asp-route-id="@Model.LearnerID"
          method="post">

        <input type="hidden" asp-for="LearnerID" />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Back to List
        </a>
    </form>
</div>