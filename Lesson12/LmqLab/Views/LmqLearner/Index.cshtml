
@model IEnumerable<LmqLab.Models.Learner>

@{
    ViewData["Title"] = "Learner List";
}

<div class="container mt-4">
    <h1>Learner List</h1>

    @await Component.InvokeAsync("LmqMajor")

    <!-- Nút thêm sinh viên -->
    @* <div class="mb-3">
        <a asp-controller="LmqLearner"
           asp-action="Create"
           class="btn btn-primary">
            Create New Student
        </a>
    </div> *@

    <!-- Form tìm kiếm -->
    <form class="d-flex mb-3">
        <div class="input-group">
            <input id="keyword"
                   class="form-control"
                   name="keyword"
                   type="text"
                   placeholder="Search learner" />

            <button id="btnSearch"
                    class="btn btn-primary"
                    type="button">
                Search
            </button>
        </div>
    </form>

    <div id="content">
        @await Html.PartialAsync("LmqLearnerTable", Model)
    </div>

    <div class="mt-3 mb-4">
    <a asp-controller="LmqLearner"
       asp-action="Create"
       class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Thêm sinh viên
    </a>
</div>

</div>

@section Scripts {
    <script>
        // Nhấn vào số trang
        $('body').on('click', 'li.page-item', function (e) {
            var page = $(this).attr("page");
            var mid = $(this).attr("mid");
            var keyword = $(this).attr("keyword");

            var data = {
                mid: mid,
                keyword: keyword,
                pageIndex: page
            };

            $.ajax({
                url: "/LmqLearner/LmqLearnerFilter",
                data: data,
                success: function (response) {
                    $("#content").html(response);
                }
            });
        });

        // Nhấn vào ngành học
        $("#majors li").click(function (e) {
            var id = $(this).attr("id");

            $.ajax({
                url: "/LmqLearner/LmqLearnerFilter",
                data: { mid: id },
                success: function (response) {
                    $("#content").html(response);
                }
            });
        });

        // Nhấn nút tìm kiếm
        $("button#btnSearch").click(function (e) {
            var keyword = $("#keyword").val();

            $.ajax({
                url: "/LmqLearner/LmqLearnerFilter",
                data: { keyword: keyword },
                success: function (response) {
                    $("#content").html(response);
                }
            });
        });
    </script>
}
