
@model LmqLab.Models.Learner

@{
    ViewData["Title"] = "Create Student";
}

<div class="container">
    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="mb-0">Create New Student</h4>
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FirstMidName"
                           class="form-label">
                        Tên
                    </label>

                    <input asp-for="FirstMidName"
                           class="form-control"
                           placeholder="Nhập tên sinh viên" />

                    <span asp-validation-for="FirstMidName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LastName"
                           class="form-label">
                        Họ
                    </label>

                    <input asp-for="LastName"
                           class="form-control"
                           placeholder="Nhập họ sinh viên" />

                    <span asp-validation-for="LastName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EnrollmentDate"
                           class="form-label">
                        Ngày nhập học
                    </label>

                    <input asp-for="EnrollmentDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="EnrollmentDate"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MajorId"
                           class="form-label">
                        Ngành học
                    </label>

                    <select asp-for="MajorId"
                            asp-items="ViewBag.MajorId"
                            class="form-select">
                        <option value="">-- Chọn ngành học --</option>
                    </select>

                    <span asp-validation-for="MajorId"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Create
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Back to List
                </a>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
