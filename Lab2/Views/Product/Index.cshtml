@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var products = ViewBag.Products;
    var categories = ViewBag.Categories;
}

<div class="row">
    <div class="col-md-3">
        <h4>DANH MỤC</h4>
        <ul class="list-group">
            @foreach (var cat in categories)
            {
                <li class="list-group-item">
                    <a asp-route="product-index" asp-route-categoryId="@cat.Id">@cat.Name</a>
                </li>
            }
        </ul>
    </div>

    <div class="col-md-9">
        <h4>Danh sách sản phẩm</h4>
        <div class="row">
            @foreach (var item in products)
            {
                <div class="col-md-4 mb-4">
                    <div class="thumbnail">
                        <img src="@item.Image" alt="" style="width:100%" />
                        <div class="caption">
                            <h4>@item.Name</h4>
                            <p>
                                <strike>Giá: @item.Price.ToString("N0")</strike>
                                Giá: @item.SalePrice.ToString("N0")
                            </p>
                            <p>
                                <a asp-route="product-detail" asp-route-id="@item.Id" class="btn btn-success btn-block">Chi tiết</a>
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>