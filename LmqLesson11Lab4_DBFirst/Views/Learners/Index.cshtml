@model IEnumerable<LmqLesson11Lab4_DBFirst.Models.Learner>

@{
    ViewData["Title"] = "Index";
}

<h1>Danh sách sinh viên</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Họ</th>
            <th>Tên đệm và tên</th>
            <th>Ngày nhập học</th>
            <th>Chuyên ngành</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.LastName</td>
                <td>@item.FirstMidName</td>
                <td>@item.EnrollmentDate.ToShortDateString()</td>
                <td>@item.Major?.MajorName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.LearnerId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.LearnerId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.LearnerId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
