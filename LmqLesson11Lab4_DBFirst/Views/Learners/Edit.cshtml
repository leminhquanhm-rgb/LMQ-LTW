@model LmqLesson11Lab4_DBFirst.Models.Learner

@{
    ViewData["Title"] = "Edit";
}

<h1>Sửa thông tin sinh viên</h1>

<h4>Learner</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="All" class="text-danger"></div>

            <input type="hidden" asp-for="LearnerId" />

            <div class="form-group">
                <label asp-for="LastName" class="control-label">Họ</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FirstMidName" class="control-label">Tên đệm và tên</label>
                <input asp-for="FirstMidName" class="form-control" />
                <span asp-validation-for="FirstMidName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EnrollmentDate" class="control-label">Ngày nhập học</label>
                <input asp-for="EnrollmentDate" type="date" class="form-control" />
                <span asp-validation-for="EnrollmentDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MajorId" class="control-label">Chuyên ngành</label>
                <select asp-for="MajorId" asp-items="ViewBag.MajorId" class="form-control">
                    <option value="">-- Chọn chuyên ngành --</option>
                </select>
                <span asp-validation-for="MajorId" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
