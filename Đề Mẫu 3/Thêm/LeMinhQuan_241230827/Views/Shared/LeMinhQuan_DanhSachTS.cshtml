@model List<TaiSan>

<div class="section-head">
    <h3>@ViewData["TieuDe"]</h3>
</div>

<div class="grid">
    @foreach (var ts in Model)
    {
        <div class="asset-card">
            <a href="#"><img src="~/images/@ts.Anh" alt="@ts.TenTs"/></a>
            <h2>@ts.TenTs</h2>
            <div class=" asset-foot">
                <span class="price">@(ts.NguyenGia.HasValue ? $"{ts.NguyenGia:N0} tr" : "Chưa định giá")</span>
                <button class="btn-buy">Chi tiết</button>
            </div>

        </div>

    }
</div>