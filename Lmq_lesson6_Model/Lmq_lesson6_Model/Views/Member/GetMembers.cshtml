@{
}

<div class="alert alert-warning">
    <h2>Danh Sách Thành Viên</h2>
    <table>
        <tr>
            <th>Mã sinh viên</th>
            <th>Username</th>
            <th>Họ và Tên</th>
            <th>Password</th>
            <th>Email</th>
        </tr>

        @foreach(var m in ViewBag.members)
        {
            <tr>
                <td>@m.MemberId</td>
                <td>@m.Username</td>
                <td>@m.Fullname</td>
                <td>@m.Password</td>
                <td>@m.Email</td>
            </tr>
        }
    </table>
</div>
