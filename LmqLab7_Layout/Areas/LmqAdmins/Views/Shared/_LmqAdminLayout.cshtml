
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Lmq Admin</title>

    <link rel="stylesheet"
          href="~/adminlte/plugins/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet"
          href="~/adminlte/dist/css/adminlte.min.css" />
</head>
<body class="hold-transition sidebar-mini">
    <div class="wrapper">

        <partial name="_LmqAdminNavbar" />

        <partial name="_LmqAdminSidebar" />

        <div class="content-wrapper">
            <section class="content-header">
                <div class="container-fluid">
                    <h1>@ViewData["Title"]</h1>
                </div>
            </section>

            <section class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>
        </div>

        <partial name="_LmqAdminFooter" />

    </div>

    <script src="~/adminlte/plugins/jquery/jquery.min.js"></script>
    <script src="~/adminlte/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/adminlte/dist/js/adminlte.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
