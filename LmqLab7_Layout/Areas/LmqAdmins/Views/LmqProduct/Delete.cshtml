@model LmqLab7_Layout.Areas.LmqAdmins.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="container-fluid">
    <div class="card card-danger">
        <div class="card-header">
            <h3 class="card-title">Xác nhận xóa sản phẩm</h3>
        </div>

        <div class="card-body">
            <div class="alert alert-warning">
                Bạn có chắc chắn muốn xóa sản phẩm này không?
            </div>

            <dl class="row">
                <dt class="col-sm-3">Mã sản phẩm</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Tên sản phẩm</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Danh mục</dt>
                <dd class="col-sm-9">@Model.Category.Name</dd>

                <dt class="col-sm-3">Giá gốc</dt>
                <dd class="col-sm-9">@Model.Price.ToString("N0") đ</dd>

                <dt class="col-sm-3">Giá khuyến mãi</dt>
                <dd class="col-sm-9">
                    @(Model.SalePrice.HasValue
                        ? Model.SalePrice.Value.ToString("N0") + " đ"
                        : "Không có")
                </dd>
            </dl>
        </div>

        <div class="card-footer">
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <button type="submit" class="btn btn-danger"
                        onclick="return confirm('Bạn chắc chắn muốn xóa sản phẩm này?');">
                    Xác nhận xóa
                </button>

                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </form>
        </div>
    </div>
</div>