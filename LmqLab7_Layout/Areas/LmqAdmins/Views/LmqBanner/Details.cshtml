@model LmqLab7_Layout.Areas.LmqAdmins.Models.Banner

@{
    ViewData["Title"] = "Chi tiết Banner";
}

<div class="container-fluid">
    <div class="card card-info">
        <div class="card-header">
            <h3 class="card-title">Chi tiết Banner</h3>
        </div>

        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.Image))
            {
                <div class="mb-3">
                    <img src="@Url.Content(Model.Image)"
                         alt="@Model.Name"
                         class="img-fluid rounded"
                         style="max-height:300px;object-fit:contain" />
                </div>
            }

            <dl class="row">
                <dt class="col-sm-3">Mã Banner</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Tên Banner</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Trạng thái</dt>
                <dd class="col-sm-9">
                    @(Model.Status ? "Đang hoạt động" : "Ngừng hoạt động")
                </dd>

                <dt class="col-sm-3">Độ ưu tiên</dt>
                <dd class="col-sm-9">@Model.Priority</dd>

                <dt class="col-sm-3">Mô tả</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "Chưa có mô tả"
                        : Model.Description)
                </dd>
            </dl>
        </div>

        <div class="card-footer">
            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="btn btn-warning">Sửa Banner</a>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </div>
</div>