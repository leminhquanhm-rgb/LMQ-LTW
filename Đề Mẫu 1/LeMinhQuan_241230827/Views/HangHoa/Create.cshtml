@model LeMinhQuan_241230827.Models.HangHoa

@{
    ViewData["Title"] = "Thêm Hàng Hóa Mới";
}

<style>
    .create-container {
        padding: 15px 0;
        font-family: Arial, Helvetica, sans-serif;
    }

    .create-container h4 {
        font-size: 16px;
        font-weight: normal;
        color: #333;
        margin-bottom: 4px;
    }

    .create-container h3 {
        font-size: 18px;
        font-weight: normal;
        color: #333;
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid #EBE8E8;
    }

    .form-group-lmq {
        margin-bottom: 12px;
    }

    .form-group-lmq label {
        display: block;
        font-size: 14px;
        color: #333;
        margin-bottom: 4px;
    }

    .form-group-lmq input[type="text"],
    .form-group-lmq select {
        width: 260px;
        padding: 5px 8px;
        border: 1px solid #B5B5B5;
        font-size: 14px;
        box-sizing: border-box;
    }

    .btn-create-lmq {
        padding: 6px 16px;
        background: #EFEFEF;
        border: 1px solid #767676;
        color: #000;
        cursor: pointer;
        font-size: 14px;
        margin-top: 4px;
    }

    .btn-create-lmq:hover {
        background: #E2E2E2;
    }

    .text-danger,
    .field-validation-error,
    .validation-summary-errors {
        color: #CD1F25;
        font-size: 13px;
        display: block;
        margin-top: 4px;
    }

    .back-link-lmq {
        display: inline-block;
        margin-top: 14px;
        font-size: 14px;
        color: #B81D22;
    }

    .back-link-lmq:hover {
        text-decoration: underline;
    }
</style>

<div class="main">
    <div class="content create-container">
        <h4>Lê Minh Quân</h4>
        <h3>Thêm Hàng Hóa Mới</h3>

        <form asp-controller="HangHoa" asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group-lmq">
                <label asp-for="MaLoai">MaLoai</label>
                <select asp-for="MaLoai" asp-items="ViewBag.MaLoai"></select>
                <span asp-validation-for="MaLoai" class="text-danger"></span>
            </div>

            <div class="form-group-lmq">
                <label asp-for="TenHang">TenHang</label>
                <input asp-for="TenHang" type="text" />
                <span asp-validation-for="TenHang" class="text-danger"></span>
            </div>

            <div class="form-group-lmq">
                <label asp-for="Gia">Gia</label>
                <input asp-for="Gia" type="text" />
                <span asp-validation-for="Gia" class="text-danger"></span>
            </div>

            <div class="form-group-lmq">
                <label asp-for="Anh">Anh</label>
                <input asp-for="Anh" type="text" placeholder="Ví dụ: Img_1.jpg" />
                <span asp-validation-for="Anh" class="text-danger"></span>
            </div>

            <div class="form-group-lmq">
                <input type="submit" value="Create" class="btn-create-lmq" />
            </div>
        </form>

        <a asp-controller="HangHoa" asp-action="Index" class="back-link-lmq">Quay lại danh sách hàng hóa</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

