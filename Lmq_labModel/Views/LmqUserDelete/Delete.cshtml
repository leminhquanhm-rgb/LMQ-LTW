@model Lmq_labModel.Models.LmqUser

<h1>Delete User</h1>

<h3>Bạn có chắc chắn muốn xóa User này không?</h3>

<div>
    <h4>Thông tin User</h4>
    <hr />

    <p>
        <strong>ID:</strong>
        @Model.Id
    </p>

    <p>
        <strong>Họ tên:</strong>
        @Model.Name
    </p>

    <p>
        <strong>Địa chỉ:</strong>
        @Model.Address
    </p>

    <p>
        <strong>Email:</strong>
        @Model.Email
    </p>
</div>

<br />

<form asp-action="DeleteConfirmed" method="post">

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Name" />
    <input type="hidden" asp-for="Address" />
    <input type="hidden" asp-for="Email" />

    <button type="submit">Delete</button>

    <a asp-controller="LmqUserList"
       asp-action="Index">
        Back to List
    </a>

</form>