@model LeMinhQuan_241230827.Models.SachListViewModel

<div class="section-head">
    <h3>@Model.TieuDe</h3>
    <a href="#">Xem tất cả &rsaquo;</a>
</div>
<div class="grid">
    @foreach (var s in Model.DanhSach)
    {
        <div class="book-card">
            <a href="#"><img src="/images/@s.Anh" alt="@s.TenSach" /></a>
            <h2>@s.TenSach</h2>
            <div class="book-foot">
                <span class="price">@s.Gia.Value.ToString("0")</span>
                <button class="btn-buy">Thêm vào giỏ</button>
            </div>
        </div>
    }
</div>